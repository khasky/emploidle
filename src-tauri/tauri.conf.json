{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emploidle",
  "version": "1.0.5",
  "identifier": "com.khasky.emploidle",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Emploidle",
        "width": 440,
        "height": 680,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "activity-events",
          "windows": [
            "main",
            "preview",
            "practice"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "publisher": "Khasky",
    "copyright": "Copyright (c) 2026 Khasky",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/khasky/emploidle/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwOUM5NDM3QTdCMTczRTEKUldUaGM3R25ONVNjOE9MNmZVbHA2SGlnYnBYaWVCRktLM2MyVkNYZXNqcno4YkRxdmozZ0lzbU0K"
    }
  }
}
