{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emploidle",
  "version": "1.0.0",
  "identifier": "com.khasky.emploidle",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Emploidle",
        "width": 340,
        "height": 300,
        "minWidth": 300,
        "minHeight": 260,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Khasky",
    "copyright": "Copyright (c) 2026 Khasky",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
